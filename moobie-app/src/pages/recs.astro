---
// The recs — every film someone wants the pool to watch, as a poster wall
// like the catalog: hover a poster to see who recommended it, click to keep
// the card open. Most recommended first, then newest. Rendered on the server;
// the bar's search, sort, and person filter work over the tiles already on
// the page.
// Read-only: the site has no login, so recommending happens in Discord
// (/rec), where the signed interaction names the recommender for free.
import { env as workerEnv } from "cloudflare:workers";
import { getRecommendations, groupRecs } from "@moobie/core";
import Layout from "../layouts/Layout.astro";

export const prerender = false;

const env = workerEnv as unknown as { DB: D1Database };
const recs = groupRecs(await getRecommendations(env.DB));

// Everyone who has recommended something, once each, keyed by username.
const people = [...new Set(recs.flatMap((r) => r.recommenders.map((p) => p.discord_username)))]
  .sort((a, b) => a.localeCompare(b));
---

<Layout>
  <section class="page">
    <header class="bar">
      <div class="seg mono">
        <button class="theme" aria-label="Switch theme" title="Switch theme"></button>
        <a class="seg-link" href="/">← graph</a>
      </div>
      <input id="search" class="search mono" type="search" placeholder="search films" autocomplete="off" spellcheck="false" />
      <select id="sort" class="select mono" aria-label="Sort films">
        <option value="wanted">most recommended</option>
        <option value="new">newest</option>
        <option value="az">a–z</option>
      </select>
      <select id="who" class="select mono" aria-label="Filter by person">
        <option value="">everyone</option>
        {people.map((u) => <option value={u}>{u}</option>)}
      </select>
    </header>
    <div class="grid" id="grid">
      {recs.length === 0 && <p class="mono muted load-error">no recommendations yet.</p>}
      {
        recs.map((r, i) => (
          <button class="tile" data-i={i} data-rec={JSON.stringify(r)} title={r.title}>
            {r.poster_url ? (
              <img src={r.poster_url} alt={r.title} loading="lazy" decoding="async" />
            ) : (
              <span class="no-poster display">{r.title}</span>
            )}
          </button>
        ))
      }
    </div>
    <aside class="panel" id="panel" aria-live="polite" hidden></aside>
  </section>
</Layout>

<script>
  import { recCardHtml } from "../lib/cards";
  import type { RecFilm } from "@moobie/core";

  const grid = document.getElementById("grid")!;
  const panel = document.getElementById("panel")!;
  const search = document.querySelector<HTMLInputElement>("#search")!;
  const sort = document.querySelector<HTMLSelectElement>("#sort")!;
  const who = document.querySelector<HTMLSelectElement>("#who")!;

  // Tiles are already on the page; each carries its film as JSON.
  const tiles = [...grid.querySelectorAll<HTMLButtonElement>(".tile")];
  const film = (t: HTMLButtonElement) => JSON.parse(t.dataset.rec!) as RecFilm;

  // Same forgiving search as the catalog and the bot: case, punctuation, spacing.
  const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "");

  // "wanted" is the server's order (most recommenders, then newest), kept in data-i.
  const sorters: Record<string, (a: HTMLButtonElement, b: HTMLButtonElement) => number> = {
    wanted: (a, b) => Number(a.dataset.i) - Number(b.dataset.i),
    new: (a, b) => film(b).first_at.localeCompare(film(a).first_at),
    az: (a, b) => film(a).title.localeCompare(film(b).title),
  };

  /** Search + person filter + sort applied by hiding, showing, and reordering the tiles. */
  function render() {
    const q = norm(search.value);
    const shown = tiles
      .filter((t) => !q || norm(film(t).title).includes(q))
      .filter((t) => !who.value || film(t).recommenders.some((p) => p.discord_username === who.value))
      .sort(sorters[sort.value] ?? sorters.wanted!);
    for (const t of tiles) t.hidden = true;
    for (const t of shown) t.hidden = false;
    grid.append(...shown); // append moves the nodes, so this is the reorder
  }

  search.addEventListener("input", render);
  sort.addEventListener("change", render);
  who.addEventListener("change", render);

  // Hover a poster to see who recommended it; click to keep the card open.
  // Click the card's x, anywhere else, or Escape to put it away.
  let pinned: HTMLButtonElement | null = null;
  const tileOf = (e: Event) => (e.target as Element).closest(".tile") as HTMLButtonElement | null;
  function show(t: HTMLButtonElement) {
    panel.innerHTML = recCardHtml(film(t));
    panel.hidden = false;
  }
  function hide() {
    pinned = null;
    panel.hidden = true;
  }

  grid.addEventListener("pointerover", (e) => {
    const t = tileOf(e);
    if (t && !pinned) show(t);
  });
  grid.addEventListener("pointerleave", () => {
    if (!pinned) panel.hidden = true;
  });
  grid.addEventListener("click", (e) => {
    const t = tileOf(e);
    if (!t) return;
    if (pinned === t) return hide();
    pinned = t;
    show(t);
  });
  panel.addEventListener("click", (e) => {
    if ((e.target as Element).closest(".card-x")) hide();
  });
  document.addEventListener("click", (e) => {
    if (!(e.target as Element).closest(".tile, .panel")) hide();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") hide();
  });
</script>

<style>
  .page {
    min-height: 100dvh;
  }

  .bar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    padding: var(--space-2);
    background: var(--paper);
  }

  /* Same floating card as the catalog. */
  .panel {
    position: fixed;
    top: var(--space-2);
    right: var(--space-2);
    z-index: 20;
    max-height: calc(100dvh - 2 * var(--space-2));
    overflow-y: auto;
  }

  @media (max-width: 720px) {
    /* Same bar wrap as the catalog: search on its own row, the dropdowns split the next. */
    .search {
      flex: 1 1 100%;
      max-width: none;
    }
    .select {
      flex: 1 1 40%;
      min-width: 0;
    }
    .panel {
      top: auto;
      right: 0;
      bottom: 0;
      left: 0;
      width: auto;
      max-height: 60vh;
      border: none;
      border-top: var(--rule);
    }
  }
</style>
