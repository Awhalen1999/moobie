---
// The catalog — every film anyone in the pool has logged, as a poster wall.
// Search filters as you type; clicking a poster opens the same film card the
// graph shows: who rated it, avg, gap.
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="page">
    <header class="bar">
      <div class="seg mono">
        <button class="theme" aria-label="Switch theme" title="Switch theme"></button>
        <a class="seg-link" href="/">← graph</a>
      </div>
      <input id="search" class="search mono" type="search" placeholder="search films" autocomplete="off" spellcheck="false" />
      <select id="sort" class="sort mono" aria-label="Sort films">
        <option value="new">newest</option>
        <option value="az">a–z</option>
        <option value="avg-high">avg: high → low</option>
        <option value="avg-low">avg: low → high</option>
        <option value="most">most logged</option>
        <option value="gap">biggest gap</option>
      </select>
    </header>
    <div class="grid" id="grid"></div>
    <aside class="panel" id="panel" aria-live="polite" hidden></aside>
  </section>
</Layout>

<script>
  import { esc, filmCardHtml, type Film, type Person } from "../lib/cards";

  const grid = document.getElementById("grid")!;
  const panel = document.getElementById("panel")!;
  const search = document.getElementById("search") as HTMLInputElement;
  const sort = document.getElementById("sort") as HTMLSelectElement;

  let films: Film[] = [];
  let people: Person[] = [];
  const name = (username: string) =>
    people.find((p) => p.username === username)?.name ?? username;

  // Same forgiving search as the bot's /film: case, punctuation, spacing.
  const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "");

  function tile(f: Film): string {
    const art = f.posterUrl
      ? `<img src="${esc(f.posterUrl)}" alt="${esc(f.title)}" loading="lazy" decoding="async" />`
      : `<span class="no-poster display">${esc(f.title)}</span>`;
    return `<button class="tile" data-key="${esc(f.key)}" title="${esc(f.title)}">${art}</button>`;
  }

  function render(list: Film[]) {
    grid.innerHTML = list.map(tile).join("");
  }

  // Unrated films sink on the avg sorts; solo films sink on gap (their gap is 0 anyway).
  const gap = (f: Film) => (f.raters.length > 1 ? (f.spread ?? 0) : -1);
  const sorters: Record<string, (a: Film, b: Film) => number> = {
    az: (a, b) => a.title.localeCompare(b.title),
    "avg-high": (a, b) => (b.average ?? -1) - (a.average ?? -1),
    "avg-low": (a, b) => (a.average ?? 99) - (b.average ?? 99),
    most: (a, b) => b.raters.length - a.raters.length,
    gap: (a, b) => gap(b) - gap(a),
  };

  /** Current search filter + sort applied; "new" keeps payload order. */
  function view(): Film[] {
    const q = norm(search.value);
    const list = q ? films.filter((f) => norm(f.title).includes(q)) : [...films];
    const cmp = sorters[sort.value];
    if (cmp) list.sort((a, b) => cmp(a, b) || a.title.localeCompare(b.title)); // ties break a–z
    return list;
  }

  search.addEventListener("input", () => render(view()));
  sort.addEventListener("change", () => render(view()));

  // One listener for the whole wall: open the clicked film's card.
  grid.addEventListener("click", (e) => {
    const t = (e.target as Element).closest(".tile") as HTMLElement | null;
    if (!t) return;
    const film = films.find((f) => f.key === t.dataset.key);
    if (!film) return;
    panel.innerHTML = filmCardHtml(film, name);
    panel.hidden = false;
  });

  // Click anywhere else (or Escape) to put the card away.
  document.addEventListener("click", (e) => {
    if (!(e.target as Element).closest(".tile, .panel")) panel.hidden = true;
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") panel.hidden = true;
  });

  const res = await fetch("/api/graph");
  const data = (await res.json()) as { people: Person[]; films: Film[] };
  people = data.people;
  films = data.films; // payload order is newest watch first
  render(films);
</script>

<style>
  .page {
    min-height: 100dvh;
  }

  .bar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    background: var(--paper);
  }

  .search {
    flex: 1;
    max-width: 18rem;
    padding: 0.35rem 0;
    background: none;
    border: none;
    border-bottom: 1px solid var(--ink);
    color: var(--ink);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    outline: none;
  }
  .search::placeholder {
    color: var(--muted);
  }

  .sort {
    min-width: 14rem;
    padding: 0.35rem 1.5rem 0.35rem 0;
    background: none;
    border: none;
    border-bottom: 1px solid var(--ink);
    color: var(--ink);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    outline: none;
    cursor: pointer;
  }

  /* Customizable select: the picker anchors below the control instead of the
     macOS mid-overlay. Browsers without base-select keep the native picker. */
  .sort,
  .sort::picker(select) {
    appearance: base-select;
  }
  .sort::picker(select) {
    background: var(--paper);
    border: 1px solid var(--ink);
    padding: 0;
  }
  .sort option {
    padding: 0.4rem 0.8rem;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .sort option:hover,
  .sort option:focus {
    background: color-mix(in srgb, var(--ink) 10%, transparent);
  }
  .sort option:checked {
    background: var(--ink);
    color: var(--paper);
  }
  .sort option::checkmark {
    display: none;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 2px;
    padding: 2px;
  }
  .grid :global(.tile) {
    aspect-ratio: 2 / 3;
    padding: 0;
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    cursor: pointer;
  }
  .grid :global(.tile img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .grid :global(.tile:hover) {
    outline: 1px solid var(--ink);
    outline-offset: -1px;
  }
  .grid :global(.no-poster) {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: var(--space-1);
    font-size: 1.1rem;
    text-align: center;
  }

  .panel {
    position: fixed;
    top: var(--space-2);
    right: var(--space-2);
    z-index: 20;
    max-height: calc(100dvh - 2 * var(--space-2));
    overflow-y: auto;
  }

  @media (max-width: 720px) {
    .panel {
      top: auto;
      right: 0;
      bottom: 0;
      left: 0;
      width: auto;
      max-height: 60vh;
      border: none;
      border-top: var(--rule);
    }
  }
</style>
