---
// The graph — moobie's centerpiece. People and films as one force-directed
// map: an edge is "this person logged this film", colored by their rating.
// Shared films sit between the people who watched them; that's the whole idea.
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="board" id="board">
    <canvas id="graph"></canvas>
    <div class="controls">
      <div class="seg mono">
        <button class="theme" aria-label="Switch theme" title="Switch theme"></button>
        <a class="seg-link" href="/catalog">catalog →</a>
      </div>
      <div class="seg mono" role="group" aria-label="Graph">
        <button id="mode-films" class="active">films</button>
        <button id="mode-people">people</button>
      </div>
      <div class="seg mono" role="group" aria-label="View" id="view-toggle">
        <button id="view-shared" class="active">shared</button>
        <button id="view-all">everything</button>
      </div>
    </div>
    <aside class="panel" id="panel" aria-live="polite" hidden></aside>
    <p class="hint mono muted" id="tally">&nbsp;</p>
  </section>
</Layout>

<script>
  import {
    forceCenter,
    forceCollide,
    forceLink,
    forceManyBody,
    forceSimulation,
    forceX,
    forceY,
  } from "d3-force";

  import { esc, num, gapClass, filmCardHtml, type Film, type Person } from "../lib/cards";

  interface Payload {
    people: Person[];
    films: Film[];
    logs: number;
  }

  interface Node {
    id: string;
    kind: "person" | "film";
    r: number;
    person?: Person;
    film?: Film;
    x?: number;
    y?: number;
    fx?: number | null;
    fy?: number | null;
  }
  interface PairFilm {
    title: string;
    ra: number | null; // first name's rating (names sorted)
    rb: number | null;
  }
  interface Link {
    source: Node | string;
    target: Node | string;
    rating?: number | null; // films mode: one person's rating of one film
    shared?: number; // people mode: films the pair both logged
    avgGap?: number | null; // people mode: mean rating gap on those films
    films?: PairFilm[]; // people mode: the shared films themselves
  }

  const canvas = document.getElementById("graph") as HTMLCanvasElement;
  const board = document.getElementById("board")!;
  const panel = document.getElementById("panel")!;
  const tally = document.getElementById("tally")!;
  const ctx = canvas.getContext("2d")!;

  // Design tokens, re-read whenever the theme flips.
  let tokens = readTokens();
  function readTokens() {
    const s = getComputedStyle(document.documentElement);
    return {
      paper: s.getPropertyValue("--paper").trim(),
      ink: s.getPropertyValue("--ink").trim(),
      muted: s.getPropertyValue("--muted").trim(),
      faint: s.getPropertyValue("--faint").trim(),
      low: s.getPropertyValue("--low").trim(),
      mid: s.getPropertyValue("--mid").trim(),
      high: s.getPropertyValue("--high").trim(),
      disagreed: s.getPropertyValue("--disagreed").trim(),
    };
  }
  new MutationObserver(() => {
    tokens = readTokens();
    draw();
  }).observe(document.documentElement, { attributeFilter: ["data-theme"] });

  const bucket = (rating: number | null) =>
    rating === null ? tokens.faint : rating <= 2 ? tokens.low : rating >= 4 ? tokens.high : tokens.mid;

  // --- state ---------------------------------------------------------------

  let data: Payload = { people: [], films: [], logs: 0 };
  let nodes: Node[] = [];
  let links: Link[] = [];
  let sim: ReturnType<typeof forceSimulation<Node>> | null = null;
  let mode: "films" | "people" = "films";
  let sharedOnly = true;
  let hovered: Node | null = null;
  let focused: Node | null = null; // a clicked person
  let pinned: Node | null = null; // a clicked film, kept in the panel
  let hoveredLink: Link | null = null; // people mode: a hovered pair edge
  let pinnedLink: Link | null = null; // people mode: a clicked pair edge
  const avatars = new Map<string, HTMLImageElement>();
  const kept = new Map<string, { x: number; y: number }>(); // positions across rebuilds

  // --- simulation ------------------------------------------------------------

  /** One link per pair of people who share films: count, avg gap, the list. */
  function peopleLinks(): Link[] {
    const pairs = new Map<string, { gapSum: number; rated: number; films: PairFilm[] }>();
    for (const f of data.films) {
      for (let i = 0; i < f.raters.length; i++) {
        for (let j = i + 1; j < f.raters.length; j++) {
          const a = f.raters[i]!;
          const b = f.raters[j]!;
          const key = [a.username, b.username].sort().join("|");
          let p = pairs.get(key);
          if (!p) {
            p = { gapSum: 0, rated: 0, films: [] };
            pairs.set(key, p);
          }
          const first = key.split("|")[0] === a.username ? a : b;
          const second = first === a ? b : a;
          p.films.push({ title: f.title, ra: first.rating, rb: second.rating });
          if (a.rating !== null && b.rating !== null) {
            p.gapSum += Math.abs(a.rating - b.rating);
            p.rated++;
          }
        }
      }
    }
    return [...pairs.entries()].map(([key, p]) => {
      const [a, b] = key.split("|");
      // Biggest disagreements first; films missing a rating sink to the end.
      p.films.sort((x, y) => (pairGap(y) ?? -1) - (pairGap(x) ?? -1));
      return {
        source: `u:${a}`,
        target: `u:${b}`,
        shared: p.films.length,
        avgGap: p.rated ? Math.round((p.gapSum / p.rated) * 100) / 100 : null,
        films: p.films,
      };
    });
  }

  const pairGap = (f: PairFilm) => (f.ra !== null && f.rb !== null ? Math.abs(f.ra - f.rb) : null);

  /** Color for a pair's average gap: close is green, far is red. */
  const gapColor = (avgGap: number | null) =>
    avgGap === null ? tokens.faint : avgGap <= 1 ? tokens.high : avgGap <= 2 ? tokens.mid : tokens.low;

  function build() {
    if (sim) sim.stop();
    for (const n of nodes) if (n.x !== undefined) kept.set(n.id, { x: n.x, y: n.y! });

    if (mode === "people") {
      links = peopleLinks();
      // Avatar size tracks total shared films, so the hubs read as hubs.
      const totals = new Map<string, number>();
      for (const l of links) {
        totals.set(l.source as string, (totals.get(l.source as string) ?? 0) + (l.shared ?? 0));
        totals.set(l.target as string, (totals.get(l.target as string) ?? 0) + (l.shared ?? 0));
      }
      const most = Math.max(1, ...totals.values());
      nodes = data.people.map<Node>((p) => ({
        id: `u:${p.username}`,
        kind: "person",
        r: 16 + Math.round(((totals.get(`u:${p.username}`) ?? 0) / most) * 14),
        person: p,
      }));
    } else {
      const films = data.films.filter((f) => !sharedOnly || f.raters.length >= 2);
      nodes = [
        ...data.people.map<Node>((p) => ({ id: `u:${p.username}`, kind: "person", r: 17, person: p })),
        ...films.map<Node>((f) => ({ id: `f:${f.key}`, kind: "film", r: 6 + f.raters.length * 3, film: f })),
      ];
      links = films.flatMap((f) =>
        f.raters.map((r) => ({ source: `u:${r.username}`, target: `f:${f.key}`, rating: r.rating })),
      );
    }

    for (const n of nodes) {
      const prev = kept.get(n.id);
      if (prev) {
        n.x = prev.x;
        n.y = prev.y;
      }
    }

    sim = forceSimulation<Node>(nodes)
      .force(
        "link",
        forceLink<Node, Link>(links)
          .id((d) => d.id)
          .distance((l) =>
            mode === "people"
              ? 150 - Math.min(l.shared ?? 1, 10) * 7
              : 46 + ((l.target as Node).film?.raters.length ?? 1) * 8,
          )
          .strength(mode === "people" ? 0.4 : 0.5),
      )
      .force(
        "charge",
        forceManyBody<Node>().strength((d) =>
          mode === "people" ? -500 : d.kind === "person" ? -520 : -42,
        ),
      )
      .force("collide", forceCollide<Node>((d) => d.r + (d.kind === "person" ? 16 : 5)))
      .force("center", forceCenter(0, 0))
      .force("x", forceX(0).strength(0.045))
      .force("y", forceY(0).strength(0.06))
      .on("tick", draw);
    sim.alpha(1).restart();
  }

  // --- drawing ---------------------------------------------------------------

  let width = 0;
  let height = 0;

  function resize() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    width = board.clientWidth;
    height = canvas.clientHeight;
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    draw();
  }
  new ResizeObserver(resize).observe(board);

  // Auto-fit: when the blob outgrows the viewport, the whole map shrinks to
  // fit — never clipped, never scaled up past 1:1.
  const FIT_PAD = 28;
  let view = { scale: 1, cx: 0, cy: 0 };
  function fitView() {
    let minX = Infinity;
    let minY = Infinity;
    let maxX = -Infinity;
    let maxY = -Infinity;
    for (const n of nodes) {
      if (n.x === undefined) continue;
      minX = Math.min(minX, n.x - n.r);
      maxX = Math.max(maxX, n.x + n.r);
      minY = Math.min(minY, n.y! - n.r);
      maxY = Math.max(maxY, n.y! + n.r);
    }
    if (minX === Infinity) {
      view = { scale: 1, cx: 0, cy: 0 };
      return;
    }
    view = {
      scale: Math.min(
        1,
        Math.max(1, width - 2 * FIT_PAD) / (maxX - minX),
        Math.max(1, height - 2 * FIT_PAD) / (maxY - minY),
      ),
      cx: (minX + maxX) / 2,
      cy: (minY + maxY) / 2,
    };
  }

  const touches = (l: Link, n: Node) => l.source === n || l.target === n;

  /** The node driving the dim state: the most recent click wins, so a pinned film beats a person focus. */
  const focusNode = (): Node | null => (mode === "films" && pinned ? pinned : focused);

  const inFocus = (n: Node): boolean => {
    const sel = focusNode();
    if (!sel) return true;
    if (n === sel) return true;
    if (mode === "people") return links.some((l) => touches(l, n) && touches(l, sel));
    if (sel.kind === "film") return n.kind === "person" && !!sel.film?.raters.some((r) => `u:${r.username}` === n.id);
    return n.kind === "film" && !!n.film?.raters.some((r) => `u:${r.username}` === sel.id);
  };

  function draw() {
    fitView();
    ctx.clearRect(0, 0, width, height);
    ctx.save();
    ctx.translate(width / 2, height / 2);
    ctx.scale(view.scale, view.scale);
    ctx.translate(-view.cx, -view.cy);

    // Edges, trimmed to each node's rim so they never show through the
    // translucent dots — edge and dot read as one mark.
    for (const l of links) {
      const s = l.source as Node;
      const t = l.target as Node;
      if (s.x === undefined || t.x === undefined) continue;
      const dx = t.x! - s.x!;
      const dy = t.y! - s.y!;
      const dist = Math.hypot(dx, dy);
      if (dist <= s.r + t.r) continue; // nodes touching - nothing to draw
      const ux = dx / dist;
      const uy = dy / dist;
      const sel = focusNode();
      const dim =
        (sel && !(touches(l, sel) || (mode === "films" && inFocus(s) && inFocus(t)))) ||
        (hovered && !touches(l, hovered));
      if (mode === "people") {
        const gap = l.avgGap ?? null;
        const sel = pinnedLink ?? hoveredLink;
        const active = sel === l;
        ctx.globalAlpha = dim || (sel && !active) ? 0.08 : active ? 0.95 : gap === null ? 0.5 : 0.72;
        ctx.strokeStyle = gapColor(gap);
        ctx.lineWidth = 1 + Math.min(l.shared ?? 1, 8) * 0.75 + (active ? 1 : 0);
        ctx.setLineDash(gap === null ? [3, 4] : []);
      } else {
        ctx.globalAlpha = dim ? 0.05 : l.rating === null ? 0.5 : 0.72;
        ctx.strokeStyle = bucket(l.rating ?? null);
        ctx.lineWidth = l.rating === null ? 1 : 2;
        ctx.setLineDash(l.rating === null ? [3, 4] : []);
      }
      ctx.beginPath();
      ctx.moveTo(s.x! + ux * s.r, s.y! + uy * s.r);
      ctx.lineTo(t.x! - ux * t.r, t.y! - uy * t.r);
      ctx.stroke();
    }
    ctx.setLineDash([]);

    // Films: circles — the graph is the site's one rounded exception.
    // Solo films wear their rating's bucket; shared films speak the card
    // language: green when the room agrees, orange when the gap trips.
    for (const n of nodes) {
      if (n.kind !== "film" || n.x === undefined) continue;
      const f = n.film!;
      ctx.globalAlpha = inFocus(n) ? 0.72 : 0.08;
      if (f.raters.length > 1) {
        ctx.fillStyle = f.disagreement ? tokens.disagreed : f.average !== null ? tokens.high : tokens.ink;
      } else {
        const rating = f.raters[0]?.rating ?? null;
        ctx.fillStyle = rating === null ? tokens.faint : bucket(rating);
      }
      ctx.beginPath();
      ctx.arc(n.x!, n.y!, n.r, 0, Math.PI * 2);
      ctx.fill();
      if (n === hovered || n === pinned) {
        ctx.strokeStyle = tokens.ink;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(n.x!, n.y!, n.r + 4, 0, Math.PI * 2);
        ctx.stroke();
      }
    }

    // People: round avatars with a name plate.
    for (const n of nodes) {
      if (n.kind !== "person" || n.x === undefined) continue;
      const p = n.person!;
      const size = n.r * 2;
      ctx.globalAlpha = inFocus(n) ? 1 : 0.15;
      const img = p.avatarUrl ? avatars.get(p.username) : undefined;
      ctx.save();
      ctx.beginPath();
      ctx.arc(n.x!, n.y!, n.r, 0, Math.PI * 2);
      ctx.clip();
      if (img?.complete && img.naturalWidth > 0) {
        ctx.drawImage(img, n.x! - n.r, n.y! - n.r, size, size);
      } else {
        ctx.fillStyle = tokens.paper;
        ctx.fillRect(n.x! - n.r, n.y! - n.r, size, size);
      }
      ctx.restore();
      if (n === hovered || n === focused) {
        ctx.strokeStyle = tokens.ink;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(n.x!, n.y!, n.r + 4, 0, Math.PI * 2);
        ctx.stroke();
      }
    }

    ctx.restore();
    ctx.globalAlpha = 1;
  }

  // --- interaction -----------------------------------------------------------

  function nodeAt(clientX: number, clientY: number): Node | null {
    const rect = canvas.getBoundingClientRect();
    const x = (clientX - rect.left - width / 2) / view.scale + view.cx;
    const y = (clientY - rect.top - height / 2) / view.scale + view.cy;
    let best: Node | null = null;
    let bestDist = Infinity;
    for (const n of nodes) {
      if (n.x === undefined) continue;
      const d = Math.hypot(n.x! - x, n.y! - y);
      if (d < Math.max(n.r + 8, 14) && d < bestDist) {
        best = n;
        bestDist = d;
      }
    }
    return best;
  }

  /** The pair edge under the pointer (people mode only). Nodes win over edges. */
  function linkAt(clientX: number, clientY: number): Link | null {
    if (mode !== "people") return null;
    const rect = canvas.getBoundingClientRect();
    const x = (clientX - rect.left - width / 2) / view.scale + view.cx;
    const y = (clientY - rect.top - height / 2) / view.scale + view.cy;
    let best: Link | null = null;
    let bestDist = Infinity;
    for (const l of links) {
      const s = l.source as Node;
      const t = l.target as Node;
      if (s.x === undefined || t.x === undefined) continue;
      const dx = t.x! - s.x!;
      const dy = t.y! - s.y!;
      const len2 = dx * dx + dy * dy;
      if (len2 === 0) continue;
      const u = Math.max(0, Math.min(1, ((x - s.x!) * dx + (y - s.y!) * dy) / len2));
      const d = Math.hypot(x - (s.x! + u * dx), y - (s.y! + u * dy));
      const reach = (1 + Math.min(l.shared ?? 1, 8) * 0.75) / 2 + 5;
      if (d < reach && d < bestDist) {
        best = l;
        bestDist = d;
      }
    }
    return best;
  }

  /** Panel priority: pinned things, then hovered things, then the focus. */
  function refreshPanel() {
    if (pinned) return renderPanel(pinned);
    if (pinnedLink) return renderPairPanel(pinnedLink);
    if (hovered) return renderPanel(hovered);
    if (hoveredLink) return renderPairPanel(hoveredLink);
    renderPanel(focused);
  }

  canvas.addEventListener("pointermove", (e) => {
    const n = nodeAt(e.clientX, e.clientY);
    const l = n ? null : linkAt(e.clientX, e.clientY);
    if (n !== hovered || l !== hoveredLink) {
      hovered = n;
      hoveredLink = l;
      canvas.style.cursor = n || l ? "pointer" : "default";
      if (!pinned && !pinnedLink) refreshPanel();
      draw();
    }
  });

  canvas.addEventListener("pointerleave", () => {
    hovered = null;
    hoveredLink = null;
    if (!pinned && !pinnedLink) refreshPanel();
    draw();
  });

  canvas.addEventListener("click", (e) => {
    const n = nodeAt(e.clientX, e.clientY);
    const l = n ? null : linkAt(e.clientX, e.clientY);
    if (n?.kind === "person") {
      focused = focused === n ? null : n;
      pinned = null;
      pinnedLink = null;
    } else if (n?.kind === "film") {
      pinned = pinned === n ? null : n;
      pinnedLink = null;
    } else if (l) {
      pinnedLink = pinnedLink === l ? null : l;
      pinned = null;
      focused = null;
    } else {
      focused = null;
      pinned = null;
      pinnedLink = null;
    }
    refreshPanel();
    draw();
  });

  // --- panel -----------------------------------------------------------------

  // The film card's floating ×: unpin/unhover the film, keep any person focus.
  panel.addEventListener("click", (e) => {
    if (!(e.target as Element).closest(".card-x")) return;
    pinned = null;
    hovered = null;
    refreshPanel();
    draw();
  });

  function renderPanel(n: Node | null) {
    panel.hidden = n === null;
    if (!n) {
      panel.innerHTML = "";
      return;
    }
    if (n.kind === "film") {
      panel.innerHTML = filmCardHtml(n.film!, name);
      return;
    }
    const p = n.person!;
    const mine = data.films.filter((f) => f.raters.some((r) => r.username === p.username));
    const ratings = mine
      .map((f) => f.raters.find((r) => r.username === p.username)!.rating)
      .filter((r): r is number => r !== null);
    const liked = mine.filter((f) => f.raters.some((r) => r.username === p.username && r.liked)).length;
    const shared = mine.filter((f) => f.raters.length >= 2).length;
    const avg = ratings.length ? Math.round((ratings.reduce((a, b) => a + b, 0) / ratings.length) * 100) / 100 : null;
    panel.innerHTML =
      (p.avatarUrl ? `<img class="poster" src="${esc(p.avatarUrl)}" alt="" loading="lazy" />` : "") +
      `<h3 class="person-name">${esc(p.name.toLowerCase())}</h3>` +
      `<div class="row"><span class="mono">films</span><span class="mono">${mine.length}</span></div>` +
      `<div class="row"><span class="mono">shared</span><span class="mono">${shared}</span></div>` +
      `<div class="row"><span class="mono">avg</span><span class="mono">${avg ?? "-"}</span></div>` +
      `<div class="row"><span class="mono">liked</span><span class="mono">${liked}</span></div>`;
  }

  function name(username: string): string {
    return data.people.find((p) => p.username === username)?.name ?? username;
  }

  const PAIR_LIST_MAX = 12;

  /** A small square avatar for pair cards; a faint block when there's none. */
  const mini = (p: Person) =>
    p.avatarUrl
      ? `<img class="mini" src="${esc(p.avatarUrl)}" alt="${esc(p.name)}" loading="lazy" />`
      : `<span class="mini"></span>`;

  /**
   * The pair card: both pfps and names, the pair's numbers, then the shared
   * films as a two-column table — each person's rating under their own face.
   */
  function renderPairPanel(l: Link) {
    panel.hidden = false;
    const a = (l.source as Node).person!;
    const b = (l.target as Node).person!;
    const films = l.films ?? [];

    const rows = films
      .slice(0, PAIR_LIST_MAX)
      .map(
        (f) =>
          `<div class="pair-row"><span class="pair-film ${gapClass(pairGap(f))}" title="${esc(f.title)}">${esc(f.title)}</span>` +
          `<span class="mono">${num(f.ra)}</span><span class="mono">${num(f.rb)}</span></div>`,
      )
      .join("");
    const more =
      films.length > PAIR_LIST_MAX
        ? `<p class="mono muted">+ ${films.length - PAIR_LIST_MAX} more</p>`
        : "";

    panel.innerHTML =
      `<div class="pair-heads">${mini(a)}${mini(b)}</div>` +
      `<h3 class="person-name pair-name">${esc(a.name.toLowerCase())} &amp; ${esc(b.name.toLowerCase())}</h3>` +
      `<div class="row"><span class="mono">shared</span><span class="mono">${l.shared ?? 0}</span></div>` +
      `<div class="row"><span class="mono">avg gap</span><span class="mono ${gapClass(l.avgGap ?? null)}">${l.avgGap ?? "-"}</span></div>` +
      (films.length
        ? `<div class="pair-row cols"><span></span>${mini(a)}${mini(b)}</div>` + rows
        : "") +
      more;
  }

  // --- mode + view toggles ---------------------------------------------------

  const btnFilms = document.getElementById("mode-films")!;
  const btnPeople = document.getElementById("mode-people")!;
  const viewToggle = document.getElementById("view-toggle")!;
  const btnShared = document.getElementById("view-shared")!;
  const btnAll = document.getElementById("view-all")!;

  function reset() {
    focused = null;
    pinned = null;
    hovered = null;
    hoveredLink = null;
    pinnedLink = null;
    renderPanel(null);
    build();
  }

  function setMode(m: "films" | "people") {
    mode = m;
    btnFilms.classList.toggle("active", m === "films");
    btnPeople.classList.toggle("active", m === "people");
    viewToggle.hidden = m === "people"; // shared/everything only means something with film nodes
    reset();
  }
  btnFilms.addEventListener("click", () => setMode("films"));
  btnPeople.addEventListener("click", () => setMode("people"));

  function setView(shared: boolean) {
    sharedOnly = shared;
    btnShared.classList.toggle("active", shared);
    btnAll.classList.toggle("active", !shared);
    reset();
  }
  btnShared.addEventListener("click", () => setView(true));
  btnAll.addEventListener("click", () => setView(false));

  // --- boot ----------------------------------------------------------------

  // One payload drives everything. If it can't load, say so - an empty board
  // with no message reads as "no data" and lies.
  try {
    const res = await fetch("/api/graph");
    if (!res.ok) throw new Error(`graph api ${res.status}`);
    data = (await res.json()) as Payload;

    for (const p of data.people) {
      if (!p.avatarUrl) continue;
      const img = new Image();
      img.src = p.avatarUrl;
      img.onload = () => draw();
      avatars.set(p.username, img);
    }

    const shared = data.films.filter((f) => f.raters.length > 1).length;
    tally.textContent = `${data.people.length} people · ${data.films.length} films (${shared} shared) · ${data.logs} logs`;
  } catch (err) {
    console.error("moobie: graph payload failed:", err);
    tally.textContent = "couldn't load the graph - refresh to try again.";
  }

  resize();
  // The shared view is the point, but until the pool actually overlaps it
  // would be an empty map - open on everything while shared films are scarce.
  setView(data.films.filter((f) => f.raters.length > 1).length >= 4);
</script>

