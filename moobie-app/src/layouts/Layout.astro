---
// Bare site shell: fonts, tokens, and the pre-paint theme stamp. No nav yet —
// it gets designed after the core pages exist.
import "../styles/global.css";

interface Props {
  title?: string;
}
const { title = "moobie" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="moobie RSS feed web UI" />
    <title>{title}</title>
    <script is:inline>
      // Stamp the theme before first paint: stored choice, else system.
      const stored = localStorage.getItem("moobie-theme");
      const dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.dataset.theme = dark ? "dark" : "light";
    </script>
  </head>
  <body>
    <main>
      <slot />
    </main>
    <script is:inline>
      // Every page renders its own .theme button; one delegated handler flips them all.
      document.addEventListener("click", (e) => {
        if (!e.target.closest(".theme")) return;
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("moobie-theme", next);
      });
    </script>
  </body>
</html>
