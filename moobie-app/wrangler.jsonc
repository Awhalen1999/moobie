{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-17",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "moobie-app",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		// Verifies Discord's Ed25519 signature on /interactions. Public, not a secret.
		"DISCORD_PUBLIC_KEY": "0d642e6c8f80ddd76044a148b2051741a3b7a2c969148a3383c9070f121e0f3b"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "moobie",
			"database_id": "541321e9-173c-4e57-b3f9-6f991a838c71"
		}
	]
}