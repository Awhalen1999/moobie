{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moobie-poll",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["global_fetch_strictly_public"],
  // Cron-only Worker: no fetch handler, so no public URL either.
  "workers_dev": false,
  "triggers": {
    // Every 30 minutes. A missed tick self-heals on the next one.
    "crons": ["*/30 * * * *"]
  },
  "vars": {
    // Where announcements go: comma-separated channel ids (one data pool,
    // broadcast to N channels — can span servers). Currently moobie's home
    // server. Not a secret — the one secret (DISCORD_BOT_TOKEN) goes in via
    // `wrangler secret put`.
    "DISCORD_ANNOUNCE_CHANNEL_IDS": "1528009127505301716"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moobie",
      "database_id": "541321e9-173c-4e57-b3f9-6f991a838c71"
    }
  ],
  "observability": {
    "enabled": true
  }
}
