{
  "name": "moobie-poll",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "moobie hourly cron Worker: poll Letterboxd diaries, insert new logs into D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute moobie --local --file=../db/schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@moobie/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260717.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.112.0"
  }
}
